section .wrap{max-width:1100px;margin:0 auto}\n.faq-grid{display:grid;grid-template-columns:1fr 1fr;gap:2.5rem;border-top:1px solid var(--ink);padding-top:2rem}\n@media (max-width:760px){.faq-grid{grid-template-columns:1fr}}\n.faq-item{padding:1.2rem 0;border-bottom:1px solid var(--line)}\n.faq-item h3{font-size:1.02rem;margin-bottom:.4rem;color:var(--ink);position:relative;padding-left:1.4rem}\n.faq-item h3::before{content:\"Q\";position:absolute;left:0;top:0;background:var(--orange);color:#fff;width:1rem;height:1.1rem;display:flex;align-items:center;justify-content:center;font-size:.7rem;font-weight:700;border-radius:2px}\n.faq-item p{padding-left:1.4rem;font-size:.94rem;color:#333;margin:0}\n\n/* 流程与说明 */\n.howto{padding:4rem 1.5rem;background:#fff;border-top:1px solid var(--line)}\n.howto .wrap{max-width:1100px;margin:0 auto}\n.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:0;background:var(--line);border:1px solid var(--line);margin-top:1.5rem}\n@media (max-width:820px){.steps{grid-template-columns:1fr 1fr}}\n@media (max-width:480px){.steps{grid-template-columns:1fr}}\n.step{background:#fff;padding:1.4rem 1.3rem;border-left:8px solid var(--orange)}\n.step:nth-child(2){border-left-color:var(--orange-2)}\n.step:nth-child(3){border-left-color:var(--orange)}\n.step:nth-child(4){border-left-color:var(--orange-deep)}\n.step .n{font-size:.78rem;color:var(--mute);letter-spacing:.25em}\n.step h3{font-size:1.02rem;margin:.4rem 0 .4rem}\n.step p{font-size:.9rem;color:#444;margin:0}\n\n/* footer 导航：底部固定式文字导航（自然流动底部）*/\n.footer-nav{background:#111;color:#fff;padding:3rem 1.5rem 1.2rem}\n.footer-nav .wrap{max-width:1100px;margin:0 auto}\n.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:2rem;border-bottom:1px solid #333;padding-bottom:1.5rem;margin-bottom:1.5rem}\n@media (max-width:760px){.footer-grid{grid-template-columns:1fr 1fr}}\n.footer-grid h4{font-size:.85rem;letter-spacing:.18em;text-transform:uppercase;color:#aaa;margin-bottom:.8rem}\n.footer-grid ul{list-style:none;padding:0;margin:0}\n.footer-grid li{margin-bottom:.4rem;font-size:.92rem}\n.footer-grid li a{color:#ddd;border-bottom:1px solid transparent}\n.footer-grid li a:hover{color:var(--orange-2);border-bottom-color:var(--orange-2)}\n.brandline{font-size:1.4rem;font-weight:700;color:#fff;margin-bottom:.6rem}\n.brandline em{font-style:normal;color:var(--orange-2)}\n.colophon{font-size:.78rem;color:#888;text-align:center;border-top:1px solid #1d1d1d;padding-top:1rem}\n</style>\n<header class=\"hero\" id=\"top\">\n  <div class=\"hero-band\">\n    <div class=\"hero-inner\">\n      <span class=\"eyebrow\">A TRAVEL NOTEBOOK · ISSUE 2025</span>\n      <h1>世界那么大<br><span>把每一次出发，变成有坐标的旅行。</span></h1>\n      <p class=\"lede\">一份订阅式的出境旅行笔记与目的地指南。我们不替你打包，却愿意替你把每个目的地的街区、车站、时差、餐厅窗口与黄昏的光线，写成可对照的路线表。</p>\n      <div class=\"hero-meta\">\n        <div><b>每月一刊</b> · 纸质 + 数字版同步寄送</div>\n        <div><b>120+ 城市</b> · 已整理街区与时段</div>\n        <div><b>可打印清单</b> · 带走一身轻</div>\n      </div>\n    </div>\n  </div>\n\n  \n  <section class=\"band-cream\">\n    <div class=\"wrap\">\n      <h2>这一刊的编辑手记 ——<br><em>为什么我们仍然在路上写字。</em></h2>\n      <p class=\"note\">主笔 / 阿橘 · 2025 年春季刊前言</p>\n    </div>\n  </section>\n</header>\n\n<main>\n\n\n<section class=\"section\" id=\"journal\">\n  <div class=\"essay\">\n    <h3>第一段：把旅行写回纸上</h3>\n    <p>我们花了六年时间，跟着 170 位作者走过北海道的雪夜、伊斯坦布尔的渡轮口、里斯本 28 路电车的末班车。把这些记忆写在屏幕里太轻,印在纸页上又太重，最后我们选择了一种折中：纸本寄到信箱，路线留存在云端，正文则用一种近乎专栏的克制语气写出来。</p>\n\n    <h3>第二段：可对照的路线</h3>\n    <p>一栏是白天要去的地方，另一栏是傍晚要去的地方，第三栏是“如果你累了可以放弃的地方”。我们不相信赶行程的旅行，所以路线都按街区与步行分钟数划分，地铁站只是参考项，不是必选项。</p>\n\n    <p class=\"pull\">“如果你只想把一个下午过成一首诗，去这条小巷的尽头，那里有家只卖三种面包的店。” —— 摘自《里斯本四月刊》</p>\n\n    <h3>第三段：可打印的清单</h3>\n    <p>出发前一晚，把它打印两张装在护照本里。一张是必要物件清单——按行李箱分区，分拆成“易丢、口袋、贵重”三档；另一张是临行前的最后十分钟清单，告诉你此刻该合上几号箱柜、确认哪张卡是否带在身上。</p>\n\n    <h3>第四段：可订阅的节奏</h3>\n    <p>无广告、无弹窗、无算法推送。每月一封电子刊、两张 PDF 路线表、一次线上编辑答疑。订阅可以随时按下暂停键,暂停期间的刊次会在恢复后按编号补寄，不打乱你的收藏顺序。</p>\n  </div>\n</section>\n\n\n<section class=\"howto\" id=\"howto\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>四步开始一次出发</h2>\n      <span class=\"kicker\">HOW IT WORKS</span>\n    </div>\n    <div class=\"steps\">\n      <article class=\"step\">\n        <span class=\"n\">STEP 01</span>\n        <h3>挑选目的地</h3>\n        <p>从城市库筛选“已踏勘 / 编辑实地走过”的目的地。我们标注了每一位主笔的踏勘日期与停留天数。</p>\n      </article>\n      <article class=\"step\">\n        <span class=\"n\">STEP 02</span>\n        <h3>下载路线表</h3>\n        <p>下载该期对应的街区路线与时段推荐，打印或存入手机离线包。无需多余 App。</p>\n      </article>\n      <article class=\"step\">\n        <span class=\"n\">STEP 03</span>\n        <h3>整理清单</h3>\n        <p>用我们的双语清单模版替换你已有的备忘录。随身携带的，是一份你看得懂、我们也看得懂的清单。</p>\n      </article>\n      <article class=\"step\">\n        <span class=\"n\">STEP 04</span>\n        <h3>路上回信</h3>\n        <p>每位订阅者每月有一次“路上回信”机会，主笔会在下一期刊物里挑选真实问题作答。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"toolbar-section\" id=\"tools\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>出发前要准备的三件小事</h2>\n      <span class=\"kicker\">ESSENTIALS</span>\n    </div>\n    <div class=\"card-bar\">\n      <article class=\"bar-card\">\n        <h3>双语街区路线表</h3>\n        <p>每个目的地配一张 PDF，按白天、傍晚、夜里三档划分。所有地名附注罗马拼写与本地语言双版本，便于与出租司机沟通。</p>\n        <div class=\"meta\">格式 PDF · A4 横版 · 离线包可下载</div>\n      </article>\n      <article class=\"bar-card\">\n        <h3>随身物件清单</h3>\n        <p>替换你收藏夹里那份越来越长的购物清单。按行李箱分区、机场安检分级、丢失后再补三个维度整理，可复制粘贴到任何笔记应用。</p>\n        <div class=\"meta\">格式 TXT · 双语 · 支持复制</div>\n      </article>\n      <article class=\"bar-card\">\n        <h3>街区窗口提醒</h3>\n        <p>我们帮你订了 12 个城市的“黄昏光线提醒”,邮件会在日历的指定时间发送一段话,告诉你去哪里看那天的晚霞。</p>\n        <div class=\"meta\">服务 邮件 · 每周一次 · 可关闭</div>\n      </article>\n    </div>\n  </div>\n</section>\n\n\n<section class=\"plans-section\" id=\"plans\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>选择适合你的订阅节奏</h2>\n      <span class=\"kicker\">SUBSCRIPTION</span>\n    </div>\n    <p>三档均为月度计费，按年付费可节省两个月金额。所有档位包含每月一封数字刊物与若干 PDF 路线表；纸质刊寄送仅限中国大陆地址，外加邮费另计。</p>\n    <table class=\"plans-table\" aria-label=\"世界那么大订阅套餐对比\">\n      <thead>\n        <tr>\n          <th>套餐</th>\n          <th>价格</th>\n          <th class=\"feat\">刊物</th>\n          <th class=\"feat\">路线表</th>\n          <th class=\"feat\">清单模版</th>\n          <th class=\"feat\">窗口提醒</th>\n          <th class=\"feat\">答疑权限</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"plan-name\">基础版</td>\n          <td class=\"plan-price\">¥15/月<small>按年付 ¥150/年</small></td>\n          <td class=\"center\">每月一封数字刊</td>\n          <td class=\"center\">当月目的地 1 份</td>\n          <td class=\"center\">基础清单 1 份</td>\n          <td class=\"center\">—</td>\n          <td class=\"center\">读者信箱</td>\n        </tr>\n        <tr class=\"highlight\">\n          <td class=\"plan-name\">旗舰版<span class=\"pill\">推荐</span></td>\n          <td class=\"plan-price\">¥35/月<small>按年付 ¥350/年</small></td>\n          <td class=\"center\">数字 + 纸质双刊</td>\n          <td class=\"center\">当月全部目的地</td>\n          <td class=\"center\">完整清单合集</td>\n          <td class=\"center\">当月所有城市</td>\n          <td class=\"center\">月度编辑答疑</td>\n        </tr>\n        <tr>\n          <td class=\"plan-name\">团队版</td>\n          <td class=\"plan-price\">¥85/月<small>按年付 ¥850/年</small></td>\n          <td class=\"center\">数字 + 纸质 5 份</td>\n          <td class=\"center\">所有历史 + 新刊</td>\n          <td class=\"center\">团队共享版</td>\n          <td class=\"center\">定制城市名单</td>\n          <td class=\"center\">专属主笔答疑</td>\n        </tr>\n      </tbody>\n    </table>\n    <p>按年付费在订阅期内可享同城期内刊次补寄服务。订阅随时可暂停或终止。</p>\n  </div>\n</section>\n\n\n<section class=\"faq-section\" id=\"faq\">\n  <div class=\"wrap\">\n    <div class=\"section-head\">\n      <h2>出发前常被问到的问题</h2>\n      <span class=\"kicker\">FAQ</span>\n    </div>\n    <div class=\"faq-grid\">\n      <article class=\"faq-item\">\n        <h3>《世界那么大》是按月寄，还是一次性寄齐？</h3>\n        <p>两种都可以。月付订阅会按刊次顺序每月寄送；年付订阅可选择一次性邮寄整年刊次（平邮免邮费），或者保留每月节奏以便你在路上收到当期。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>纸质刊寄送范围与运费？</h3>\n        <p>目前纸质刊寄送仅限中国大陆地址。基础版与旗舰版免邮，团队版每次寄送收取 ¥10 邮费，可在订阅期内累积。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>电子刊与 PDF 路线表如何领取？</h3>\n        <p>订阅登记后我们会发送一封含有入口链接的邮件，每月新刊推送会同时以邮件与站内消息送达。已寄送的刊物可在“订阅档案”中随时下载 PDF。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>可以单独购买某一期的路线表吗？</h3>\n        <p>单期路线表以单本装订册形式出售，¥28/册，含全部街区路线与编辑手记。如果你只想先试读一册，欢迎选择单期购买。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>每个目的地的内容，是谁写的？</h3>\n        <p>所有目的地均由“主笔 + 在地作者”两段编辑完成。主笔负责整体节奏与章节顺序，在地作者补充街区细节与方言注音。每位作者的真名与踏勘日期都刊印在末页。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>中途暂停订阅会不会影响已寄刊？</h3>\n        <p>不会。已寄送的刊物与历史路线表都可在订阅档案中随时查看。恢复订阅后，未寄出刊次会按刊号补寄，不打乱编号顺序。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>“黄昏光线提醒”是怎么实现的？</h3>\n        <p>我们使用本地的天文学日落数据，结合主笔对每个城市“黄昏好去处”的标注，在日历提醒日发送一段话与一张地图缩略图。你随时可以在账户中关闭这一项。</p>\n      </article>\n      <article class=\"faq-item\">\n        <h3>团队版适合什么样的群体？</h3>\n        <p>适合在公司、学校社团、家庭群或朋友群中“共同读刊”的场景。一个团队版账号支持 5 个独立邮箱同时接收刊物，所有路线表与清单模版在团队内可共享。</p>\n      </article>\n    </div>\n  </div>\n</section>\n\n</main>\n\n\n<nav class=\"footer-nav\" aria-label=\"底部导航\">\n  <div class=\"wrap\">\n    <div class=\"footer-grid\">\n      <div>\n        <div class=\"brandline\">世界那么大 <em>The Travel Notebook</em></div>\n        <p>每个月的第一个周二寄送。我们写城市，你替我们走出街区。</p>\n        <p>每月第一个周二 · 北京时间 09:00 寄送</p>\n      </div>\n      <div>\n        <h4>关于刊物</h4>\n        <ul>\n          <li><a href=\"#journal\">编辑手记</a></li>\n          <li><a href=\"#howto\">怎么开始</a></li>\n          <li><a href=\"#faq\">常见问题</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>订阅与价格</h4>\n        <ul>\n          <li><a href=\"#plans\">套餐对比</a></li>\n          <li><a href=\"#plans\">基础版</a></li>\n          <li><a href=\"#plans\">团队版</a></li>\n        </ul>\n      </div>\n      <div>\n        <h4>出发前准备</h4>\n        <ul>\n          <li><a href=\"#tools\">街区路线表</a></li>\n          <li><a href=\"#tools\">物件清单</a></li>\n          <li><a href=\"#tools\">黄昏提醒</a></li>\n        </ul>\n      </div>\n    </div>\n    <div class=\"colophon\">© 2025 世界那么大编辑部 · 一份订阅式的出境旅行笔记</div>\n  </div>\n</nav>",
